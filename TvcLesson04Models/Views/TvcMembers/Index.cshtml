@model IEnumerable<TvcLesson04Models.Models.DataModels.TvcMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TvcMemberId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcEmail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TvcMemberId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TvcUserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TvcPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TvcFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TvcEmail)
            </td>
            <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.TvcMemberId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.TvcMemberId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.TvcMemberId })
            </td>
        </tr>
}
    </tbody>
</table>
