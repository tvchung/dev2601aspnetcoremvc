@model IEnumerable<TvcLesson03Views.Models.TvcCategory>

<div class="alert alert-danger">
    <ul class="list-group">
        <li class="list-group-item active" aria-current="true" >DANH MỤC</li>
        @foreach (var category in Model)
        {
            @* <li>@category.Name</li> *@
            <li class="list-group-item">
                <a  asp-controller="TvcProduct" 
                    asp-action="Index" 
                    asp-route-pid="@category.id">

                    @category.Name
                </a>
            </li>
        }
    </ul>
</div>