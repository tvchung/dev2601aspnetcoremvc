<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TvcLesson03Views</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TvcLesson03Views.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_TvcHeaderPartialView")

    <div class="container">
        <main role="main" class= "row pb-3">
            <div class="col-md-2">
                @await Component.InvokeAsync("TvcCategory")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </main>
    </div>

    <partial name="_TvcFooterPartialView" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
